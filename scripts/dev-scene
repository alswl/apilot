#!/usr/bin/env python3
import errno
import os
from pathlib import Path
import pty
import select
import signal
import subprocess
import sys

root = Path(__file__).resolve().parent.parent / "desktop"
tool = subprocess.check_output(["go", "tool", "-n", "mygo"], cwd=root, text=True).strip()
master, slave = pty.openpty()
process = subprocess.Popen([tool, "dev"], cwd=root, stdin=slave, stdout=slave, stderr=slave)
os.close(slave)
output = b""
failed = False
input_open = True
try:
    while process.poll() is None:
        ready, _, _ = select.select([master] + ([sys.stdin.fileno()] if input_open else []), [], [], 0.25)
        if master in ready:
            try:
                data = os.read(master, 65536)
            except OSError as error:
                if error.errno == errno.EIO:
                    break
                raise
            if not data:
                break
            os.write(sys.stdout.fileno(), data)
            output = (output + data)[-8192:]
            if b"The previous build keeps running" in output:
                failed, output = True, b""
            if failed and b"No change to " in output:
                os.write(master, b"r\n")
                failed, output = False, b""
            elif failed and b"Rebuilt " in output:
                failed, output = False, b""
        if input_open and sys.stdin.fileno() in ready:
            data = os.read(sys.stdin.fileno(), 4096)
            if not data:
                input_open = False
            elif b"\x03" in data:
                raise KeyboardInterrupt
            else:
                os.write(master, data)
except KeyboardInterrupt:
    if process.poll() is None:
        process.send_signal(signal.SIGINT)
finally:
    if process.poll() is None:
        process.terminate()
    try:
        process.wait(timeout=10)
    except subprocess.TimeoutExpired:
        process.kill()
        process.wait()
    os.close(master)
sys.exit(process.returncode if process.returncode >= 0 else 128 - process.returncode)
